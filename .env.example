# ------------------------------------------------------------
# Copiez ce fichier en `.env` puis adaptez les valeurs.
# NE JAMAIS committer le fichier `.env` (il est dans .gitignore).
# ------------------------------------------------------------

# Environnement : development | production | test
NODE_ENV=development

# Port d'écoute du serveur HTTP
PORT=3000

# URI de connexion MongoDB (local, Docker ou MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/express_jwt_api

# Secrets JWT : utilisez des chaînes longues et aléatoires.
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=changez_moi_access_secret
JWT_REFRESH_SECRET=changez_moi_refresh_secret

# Durées de validité (format accepté par jsonwebtoken : 15m, 1h, 7d...)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Origine(s) autorisée(s) pour CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173
