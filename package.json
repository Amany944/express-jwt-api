{
  "name": "express-jwt-api",
  "version": "1.0.0",
  "description": "API REST Express.js avec authentification JWT, middlewares de vérification, contrôleurs modulaires et MongoDB (Mongoose).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": [
